    <Color x:Key="AppPageBg">#0a0a1a</Color>
    <Color x:Key="AppBarBg">#16213e</Color>
    <Color x:Key="AppLogPanelBg">#0d0d1f</Color>
    <Color x:Key="AppCardBg">#1a1a2e</Color>
    <Color x:Key="AppCardStroke">#0f3460</Color>
    <Color x:Key="AppSensorCardBg">#0d1b2a</Color>
    <Color x:Key="AppHelpCardBg">#111122</Color>
