    <Color x:Key="AppAccent">#00d4ff</Color>
    <Color x:Key="AppLabelPrimary">#ffffff</Color>
    <Color x:Key="AppLabelMuted">#888888</Color>
    <Color x:Key="AppLabelSubtle">#666666</Color>
    <Color x:Key="AppBarText">#00d4ff</Color>
    <Color x:Key="AppLogTimestamp">#555577</Color>
    <Color x:Key="AppLogText">#aaaaaa</Color>
    <Color x:Key="AppSwitchOn">#00d4ff</Color>
    <Color x:Key="AppEntryBg">#16213e</Color>
