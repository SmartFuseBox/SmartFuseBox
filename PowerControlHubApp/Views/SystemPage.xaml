<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             x:Class="PowerControlHubApp.Views.SystemPage"
             Title="System"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">
        <views:TopBarView Grid.Row="0" Title="System" ShowBackButton="True" />

        <!-- Not connected banner -->
        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2" IsVisible="{Binding IsConnected}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <!-- Settings navigation card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <HorizontalStackLayout Spacing="16">
                        <Button Text="Time"
                                Command="{Binding NavigateToTimeSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="MQTT"
                                Command="{Binding NavigateToMqttSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="SD Card"
                                Command="{Binding NavigateToSdCardSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Warnings card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Active Warnings"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AppAccent}" />

                        <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextColor="{DynamicResource AppLabelMuted}" />

                        <CollectionView ItemsSource="{Binding Warnings}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" FontSize="14" TextColor="{DynamicResource AppLabelPrimary}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No active warnings" TextColor="{DynamicResource AppLabelMuted}" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- GPIO Pins In Use card (moved from Settings) -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="GPIOs In Use"
                                   TextColor="{DynamicResource AppLabelMuted}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="↻"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AppLabelMuted}"
                                    Padding="4,0"
                                    HeightRequest="28"
                                    Command="{Binding RefreshPinsCommand}" />
                        </Grid>

                        <!-- Loading indicator -->
                        <ActivityIndicator IsRunning="{Binding IsPinsRefreshing}"
                                           IsVisible="{Binding IsPinsRefreshing}"
                                           Color="{DynamicResource AppAccent}"
                                           HeightRequest="20" />

                        <!-- Pins list (hidden while refreshing) -->
                        <Label Text="{Binding PinsInUseText}"
                               TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               FontFamily="OpenSansRegular"
                               IsVisible="{Binding IsNotPinsRefreshing}"
                               LineBreakMode="WordWrap" />

                        <!-- Count -->
                        <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="11"
                               IsVisible="{Binding HasPins}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding PinsCount, StringFormat='{0} pin(s) currently assigned'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Firmware Update card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Firmware Update"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center" />

                        <Label TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               LineBreakMode="NoWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Current version: " />
                                    <Span Text="{Binding CurrentFirmwareVersion}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               LineBreakMode="NoWrap"
                               IsVisible="{Binding IsUpdateAvailable}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Available version: " />
                                    <Span Text="{Binding AvailableFirmwareVersion}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="Check for Updates"
                                    Command="{Binding CheckForUpdateCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AppAccent}"
                                    CornerRadius="8"
                                    Padding="10,8" />
                            <Button Grid.Column="1"
                                    Text="Install"
                                    Command="{Binding InstallFirmwareCommand}"
                                    IsVisible="{Binding IsUpdateAvailable}"
                                    BackgroundColor="{DynamicResource AppAccent}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="10,8" />
                        </Grid>

                        <ActivityIndicator IsRunning="{Binding IsOtaBusy}"
                                           IsVisible="{Binding IsOtaBusy}"
                                           Color="{DynamicResource AppAccent}"
                                           HeightRequest="20" />

                        <Label Text="{Binding StatusMessage}"
                               TextColor="{DynamicResource AppAccent}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasStatusMessage}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
