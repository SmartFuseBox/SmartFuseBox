<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PowerControlHubApp.Models"
    x:Class="PowerControlHubApp.Views.Templates.SystemSensorTemplate">

    <DataTemplate x:Key="SystemSensorTemplate" x:DataType="models:SensorModel">
        <Border Style="{StaticResource SensorCardBorder}" Margin="0">
            <VerticalStackLayout Spacing="0">

                <Label Text="{Binding Name}" Style="{StaticResource SensorCardHeader}" />

                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                        <Label Text="🖥" FontSize="20" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding CpuUsage}"
                               Style="{StaticResource SensorPrimaryValue}" />
                        <Label Text="CPU" Style="{StaticResource SensorFieldLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                        <Label Text="🧠" FontSize="20" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding FreeMemory}"
                               Style="{StaticResource SensorPrimaryValue}" />
                        <Label Text="Free RAM" Style="{StaticResource SensorFieldLabel}" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </DataTemplate>

</ResourceDictionary>
