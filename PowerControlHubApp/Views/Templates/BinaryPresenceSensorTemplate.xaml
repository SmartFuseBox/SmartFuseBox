<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PowerControlHubApp.Models"
    x:Class="PowerControlHubApp.Views.Templates.BinaryPresenceSensorTemplate">

    <DataTemplate x:Key="BinaryPresenceSensorTemplate" x:DataType="models:SensorModel">
        <Border Style="{StaticResource SensorCardBorder}" Margin="0">
            <VerticalStackLayout Spacing="0">

                <Label Text="{Binding Name}" Style="{StaticResource SensorCardHeader}" />

                <VerticalStackLayout Spacing="2" Margin="0,8,0,4" HorizontalOptions="Center">
                    <Label Text="{Binding BinaryStateIcon}" FontSize="32"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding BinaryStateLabel}"
                           Style="{StaticResource SensorPrimaryValue}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </DataTemplate>

</ResourceDictionary>
