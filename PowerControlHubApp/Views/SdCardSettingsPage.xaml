<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             x:Class="PowerControlHubApp.Views.SdCardSettingsPage"
             Title="{x:Static localization:AppResources.SdCardSettingsTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <views:TopBarView Grid.Row="0" Title="{x:Static localization:AppResources.SdCardSettingsTitle}" ShowBackButton="True" />

        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2" IsVisible="{Binding IsConnected}">
            <VerticalStackLayout Padding="20" Spacing="12">

                <!-- SPI Pins card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.SpiPins}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.SckClock}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding SpiSck}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderPin12}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.MosiMasterOut}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding SpiMosi}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderPin11}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.MisoMasterIn}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding SpiMiso}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderPin13}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.Use255DisableAnyPin}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="10"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- CS Pin card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.ChipSelect}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.CsPin}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding CsPin}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderPin10}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.Use255Disable}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="10"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- Init Speed card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.InitSpeed}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.SpeedMhz}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding InitSpeed}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderSpeedMhz}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.ValidSpeeds}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="10"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save All button -->
                <Button Text="{x:Static localization:AppResources.SaveAllSettings}"
                        Command="{Binding SaveAllCommand}"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="10,8"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,8,0,0" />

                <ActivityIndicator IsRunning="{Binding IsSaving}"
                                   IsVisible="{Binding IsSaving}"
                                   Color="{DynamicResource AppAccent}"
                                   HeightRequest="20" />

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       TextColor="{DynamicResource AppAccent}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasStatusMessage}" />
            </VerticalStackLayout>
        </ScrollView>

        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
