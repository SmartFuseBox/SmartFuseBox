<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             x:Class="PowerControlHubApp.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource AppPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="⚙ Device Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AppAccent}"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,20" />

            <!-- IP Address -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Device IP Address"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="IpEntry"
                           Text="{Binding IpAddress}"
                           Placeholder="e.g. 192.168.1.100"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Url"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>


            <!-- Port -->
            <VerticalStackLayout Spacing="4">
                <Label Text="HTTP Port"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry Text="{Binding Port}"
                           Placeholder="80"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Numeric"
                           Margin="10,0"
                           ReturnType="Done" />
                </Border>
            </VerticalStackLayout>

            <!-- Theme -->
            <VerticalStackLayout Spacing="4">
                <Label Text="App Theme"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Picker ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            TextColor="{DynamicResource AppEntryText}"
                            BackgroundColor="Transparent"
                            TitleColor="{DynamicResource AppPlaceholderText}"
                            Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <!-- Save button -->
            <Button Text="Save &amp; Connect"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="0,14"
                    Margin="0,8" />

            <!-- Status feedback -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource AppAccent}"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasStatusMessage}" />

            <!-- Back to dashboard -->
            <Button Text="← Back to Dashboard"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppLabelMuted}"
                    FontSize="13"
                    Clicked="OnBackClicked" />

            <!-- Firmware Update card -->
            <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                    StrokeShape="RoundRectangle 8" Padding="14"
                    Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Firmware Update"
                           TextColor="{DynamicResource AppLabelMuted}"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center" />

                    <Label TextColor="{DynamicResource AppEntryText}"
                           FontSize="14"
                           LineBreakMode="NoWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Current version: " />
                                <Span Text="{Binding CurrentFirmwareVersion}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label TextColor="{DynamicResource AppEntryText}"
                           FontSize="14"
                           LineBreakMode="NoWrap"
                           IsVisible="{Binding IsUpdateAvailable}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Available version: " />
                                <Span Text="{Binding AvailableFirmwareVersion}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Check for Updates"
                                Command="{Binding CheckForUpdateCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                CornerRadius="8"
                                Padding="10,8" />
                        <Button Grid.Column="1"
                                Text="Install"
                                Command="{Binding InstallFirmwareCommand}"
                                IsVisible="{Binding IsUpdateAvailable}"
                                BackgroundColor="{DynamicResource AppAccent}"
                                TextColor="White"
                                CornerRadius="8"
                                Padding="10,8" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsOtaBusy}"
                                       IsVisible="{Binding IsOtaBusy}"
                                       Color="{DynamicResource AppAccent}"
                                       HeightRequest="20" />

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{DynamicResource AppAccent}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasStatusMessage}" />
                </VerticalStackLayout>
            </Border>
            <!-- Help text -->
            <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                    StrokeShape="RoundRectangle 8" Padding="14"
                    Margin="0,16,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="How to connect"
                           TextColor="{DynamicResource AppLabelMuted}"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="12" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="1. Ensure your phone/PC is on the same WiFi network as the ESP32 board.&#10;" />
                                <Span Text="2. Enter the IP address shown on the device's serial output or your router's DHCP table.&#10;" />
                                <Span Text="3. The default port is 80.&#10;" />
                                <Span Text="4. Tap Save &amp; Connect, then return to the Dashboard." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- GPIO Pins In Use card -->
            <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                    StrokeShape="RoundRectangle 8" Padding="14"
                    Margin="0,4,0,0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="GPIOs In Use"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="↻"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppLabelMuted}"
                                Padding="4,0"
                                HeightRequest="28"
                                Command="{Binding RefreshPinsCommand}" />
                    </Grid>

                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsPinsRefreshing}"
                                       IsVisible="{Binding IsPinsRefreshing}"
                                       Color="{DynamicResource AppAccent}"
                                       HeightRequest="20" />

                    <!-- Pins list (hidden while refreshing) -->
                    <Label Text="{Binding PinsInUseText}"
                           TextColor="{DynamicResource AppEntryText}"
                           FontSize="14"
                           FontFamily="OpenSansRegular"
                           IsVisible="{Binding IsNotPinsRefreshing}"
                           LineBreakMode="WordWrap" />

                    <!-- Count -->
                    <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="11"
                           IsVisible="{Binding HasPins}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding PinsCount, StringFormat='{0} pin(s) currently assigned'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>