<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             x:Class="PowerControlHubApp.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">
        <views:TopBarView Grid.Row="0" Title="⚙ Settings"
                  RightButtonText="↻"
                  RightButtonCommand="{Binding SaveCommand}"
                  RightButtonIsEnabled="{Binding IsNotBusy}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

            <!-- IP Address -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Device IP Address"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="IpEntry"
                           Text="{Binding IpAddress}"
                           Placeholder="e.g. 192.168.1.100"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Url"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>


            <!-- Port -->
            <VerticalStackLayout Spacing="4">
                <Label Text="HTTP Port"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry Text="{Binding Port}"
                           Placeholder="80"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Numeric"
                           Margin="10,0"
                           ReturnType="Done" />
                </Border>
            </VerticalStackLayout>

            <!-- API Key -->
            <VerticalStackLayout Spacing="4">
                <Label Text="API Key (X-API-Key)"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="ApiKeyEntry"
                           Text="{Binding ApiKey}"
                           Placeholder="Optional – device API key for authentication"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>

            <!-- HMAC Key -->
            <VerticalStackLayout Spacing="4">
                <Label Text="HMAC Key (X-Auth-Signature)"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="HmacKeyEntry"
                           Text="{Binding HmacKey}"
                           Placeholder="Optional – HMAC-SHA256 key for authentication"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>

            <!-- Theme -->
            <VerticalStackLayout Spacing="4">
                <Label Text="App Theme"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Picker ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            TextColor="{DynamicResource AppEntryText}"
                            BackgroundColor="Transparent"
                            TitleColor="{DynamicResource AppPlaceholderText}"
                            Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <!-- Save button -->
            <Button Text="Save &amp; Connect"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="0,14"
                    Margin="0,8" />

            <!-- Status feedback -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource AppAccent}"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasStatusMessage}" />

            <!-- Help text -->
            <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                    StrokeShape="RoundRectangle 8" Padding="14"
                    Margin="0,16,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="How to connect"
                           TextColor="{DynamicResource AppLabelMuted}"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="12" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="1. Ensure your phone/PC is on the same WiFi network as the ESP32 board.&#10;" />
                                <Span Text="2. Enter the IP address shown on the device's serial output or your router's DHCP table.&#10;" />
                                <Span Text="3. The default port is 80.&#10;" />
                                <Span Text="4. If the device has network authentication enabled (C19:e=1), enter the API Key or HMAC Key above to match the device's configuration.&#10;" />
                                <Span Text="5. Tap Save &amp; Connect, then return to the Dashboard." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- GPIO Pins In Use card moved to SystemPage.xaml -->

            </VerticalStackLayout>
        </ScrollView>
        <views:StatusBarView Grid.Row="2" />
    </Grid>
</views:BasePowerControlHubContentPage>