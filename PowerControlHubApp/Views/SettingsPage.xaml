<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization" xmlns:internal="clr-namespace:PowerControlHubApp.Internal"
             x:Class="PowerControlHubApp.Views.SettingsPage"
             Title="{x:Static localization:AppResources.Settings}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">
        <views:TopBarView Grid.Row="0" 
            Title="{x:Static internal:Constants.IconSettings} {x:Static localization:AppResources.SettingsTitle}"
            RightButtonText="↻"
            RightButtonCommand="{Binding SaveCommand}"
            RightButtonIsEnabled="{Binding IsNotBusy}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

            <!-- IP Address -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static localization:AppResources.DeviceIpAddress}"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="IpEntry"
                           Text="{Binding IpAddress}"
                           Placeholder="{x:Static localization:AppResources.PlaceholderIpAddress}"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Url"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>


            <!-- Port -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static localization:AppResources.HttpPort}"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry Text="{Binding Port}"
                           Placeholder="{x:Static localization:AppResources.PlaceholderPort}"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Keyboard="Numeric"
                           Margin="10,0"
                           ReturnType="Done" />
                </Border>
            </VerticalStackLayout>

            <!-- API Key -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static localization:AppResources.ApiKeyLabel}"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="ApiKeyEntry"
                           Text="{Binding ApiKey}"
                           Placeholder="{x:Static localization:AppResources.PlaceholderApiKey}"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>

            <!-- HMAC Key -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static localization:AppResources.HmacKeyLabel}"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Entry x:Name="HmacKeyEntry"
                           Text="{Binding HmacKey}"
                           Placeholder="{x:Static localization:AppResources.PlaceholderHmacKey}"
                           PlaceholderColor="{DynamicResource AppPlaceholderText}"
                           TextColor="{DynamicResource AppEntryText}"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Margin="10,0"
                           ReturnType="Next" />
                </Border>
            </VerticalStackLayout>

            <!-- Theme -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static localization:AppResources.AppThemeLabel}"
                       TextColor="{DynamicResource AppLabelMuted}"
                       FontSize="13" />
                <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Picker ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            TextColor="{DynamicResource AppEntryText}"
                            BackgroundColor="Transparent"
                            TitleColor="{DynamicResource AppPlaceholderText}"
                            Margin="10,0" />
                </Border>
            </VerticalStackLayout>

            <!-- Save button -->
            <Button Text="{x:Static localization:AppResources.SaveAndConnect}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="0,14"
                    Margin="0,8" />

            <!-- Status feedback -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource AppAccent}"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasStatusMessage}" />

            <!-- Help text -->
            <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                    StrokeShape="RoundRectangle 8" Padding="14"
                    Margin="0,16,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static localization:AppResources.HowToConnect}"
                           TextColor="{DynamicResource AppLabelMuted}"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="12" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static localization:AppResources.HowToConnectStep1}" />
                                <Span Text="&#10;" />
                                <Span Text="{x:Static localization:AppResources.HowToConnectStep2}" />
                                <Span Text="&#10;" />
                                <Span Text="{x:Static localization:AppResources.HowToConnectStep3}" />
                                <Span Text="&#10;" />
                                <Span Text="{x:Static localization:AppResources.HowToConnectStep4}" />
                                <Span Text="&#10;" />
                                <Span Text="{x:Static localization:AppResources.HowToConnectStep5}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- GPIO Pins In Use card moved to SystemPage.xaml -->

            </VerticalStackLayout>
        </ScrollView>
        <views:StatusBarView Grid.Row="2" />
    </Grid>
</views:BasePowerControlHubContentPage>