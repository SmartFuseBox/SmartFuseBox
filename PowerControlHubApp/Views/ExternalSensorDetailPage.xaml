<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             x:Class="PowerControlHubApp.Views.ExternalSensorDetailPage"
             Title="External Sensor"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">
        <views:TopBarView Grid.Row="0" Title="External Sensor" ShowBackButton="True" />

        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2" IsVisible="{Binding IsConnected}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="IDENTITY" FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" />
                <Entry Placeholder="Name" Text="{Binding Name}" />
                <Label Text="Sensor Type" FontAttributes="Bold" FontSize="12" TextColor="{DynamicResource AppAccent}" />
                <Picker ItemsSource="{Binding SensorTypeOptions}"
                        SelectedIndex="{Binding SelectedSensorTypeIndex}"
                        Title="Select sensor type" />

                <Label Text="MQTT" FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" />
                <Entry Placeholder="MQTT Name" Text="{Binding MqttName}" />
                <Entry Placeholder="MQTT Slug" Text="{Binding MqttSlug}" />
                <Entry Placeholder="MQTT Type" Text="{Binding MqttType}" />
                <Entry Placeholder="MQTT Device Class" Text="{Binding MqttDeviceClass}" />
                <Entry Placeholder="MQTT Unit" Text="{Binding MqttUnit}" />
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Binary" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding MqttIsBinary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" Padding="16,0,16,12" ColumnDefinitions="*,*" ColumnSpacing="10"
              IsVisible="{Binding IsConnected}">
            <Button Grid.Column="0" Text="🗑 Remove" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="{DynamicResource AppCardStroke}" TextColor="{DynamicResource AppLabelPrimary}" />
            <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>
</views:BasePowerControlHubContentPage>
