<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             x:Class="PowerControlHubApp.Views.MqttSettingsPage"
             Title="MQTT Settings"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <views:TopBarView Grid.Row="0" Title="MQTT Settings" ShowBackButton="True" />

        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2" IsVisible="{Binding IsConnected}">
            <VerticalStackLayout Padding="20" Spacing="12">

                <!-- Connection card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Connection"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="MQTT Enabled"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MqttEnabled}"
                                    OnColor="{DynamicResource AppAccent}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource AppHelpCardStroke}"
                                 Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Connection State"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MqttConnectionStateText}"
                                   TextColor="{DynamicResource AppAccent}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Broker card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Broker"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="Host / IP"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttBroker}"
                               Placeholder="e.g. 192.168.1.100"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="Port"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttPort}"
                               Placeholder="1883"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Credentials card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Credentials"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="Username"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttUsername}"
                               Placeholder="Leave empty for none"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="Password"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttPassword}"
                               Placeholder="Enter password to change"
                               IsPassword="True"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Device card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Device Identity"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="Device ID"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttDeviceId}"
                               Placeholder="e.g. boat_seawolf_01"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="Discovery Prefix"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttDiscoveryPrefix}"
                               Placeholder="homeassistant"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Advanced card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Advanced"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Home Assistant Discovery"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MqttHADiscovery}"
                                    OnColor="{DynamicResource AppAccent}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource AppHelpCardStroke}"
                                 Margin="0,4" />

                        <Label Text="Keep Alive (seconds)"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttKeepAlive}"
                               Placeholder="60"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save All button -->
                <Button Text="Save All Settings"
                        Command="{Binding SaveAllCommand}"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="10,8"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,8,0,0" />

                <ActivityIndicator IsRunning="{Binding IsSaving}"
                                   IsVisible="{Binding IsSaving}"
                                   Color="{DynamicResource AppAccent}"
                                   HeightRequest="20" />

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       TextColor="{DynamicResource AppAccent}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasStatusMessage}" />
            </VerticalStackLayout>
        </ScrollView>

        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
