<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             x:Class="PowerControlHubApp.Views.NotConnectedBanner">

    <!-- Banner visible when the viewmodel reports no connection -->
    <Border Padding="10" Margin="12,8"
            BackgroundColor="#cc4444"
            Stroke="Transparent"
            IsVisible="{Binding IsDisconnected}">
        <Label Text="{x:Static localization:AppResources.MessageNotConnected}"
               TextColor="White"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Border>

</ContentView>
