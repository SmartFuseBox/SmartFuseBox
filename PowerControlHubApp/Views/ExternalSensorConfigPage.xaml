<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:models="clr-namespace:PowerControlHubApp.Models"
             xmlns:converters="clr-namespace:PowerControlHubApp.Converters"
             x:Class="PowerControlHubApp.Views.ExternalSensorConfigPage"
             x:Name="PageRoot"
             Title="Ext. Sensors"
             BackgroundColor="{DynamicResource AppPageBg}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

            <Style x:Key="SensorCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBg}" />
                <Setter Property="Stroke" Value="{DynamicResource AppCardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SensorNameLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SensorSubLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{DynamicResource AppPageBg}">

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="*,Auto"
              BackgroundColor="{DynamicResource AppBarBg}">
            <Label Grid.Column="0"
                   Text="📡 External Sensors"
                   TextColor="{DynamicResource AppBarText}"
                   FontSize="17"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="↻"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppBarText}"
                    Padding="6,0"
                    Command="{Binding LoadCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource AppAccent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- Status / error message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{DynamicResource AppAccent}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   Margin="20,0" />

            <!-- Sensor list (8 preconfigured slots) -->
            <CollectionView ItemsSource="{Binding Sensors}"
                            IsVisible="{Binding IsNotBusy}"
                            Margin="16,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalSensorConfigModel">
                        <Border Style="{StaticResource SensorCard}"
                                Opacity="{Binding IsConfigured, Converter={x:StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">

                                <!-- Index circle -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource AppCardStroke}"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Index}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AppAccent}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <!-- Name + type -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource SensorNameLabel}" />
                                    <Label Style="{StaticResource SensorSubLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="SensorTypeName" />
                                                <Binding Path="MqttName" />
                                            </MultiBinding>
                                        </Label.Text>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="Text" Value="Not configured" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Chevron -->
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{DynamicResource AppLabelMuted}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Tap gesture -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExternalSensorConfigViewModel}}, Path=NavigateToSensorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
